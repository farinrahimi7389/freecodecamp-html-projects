* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  line-height: 1.6;
}


/* Navbar */

#navbar {
  position: fixed;
  left: 0;
  top: 0;
  width: 250px;
  height: 100%;
  background-color: #222;
  color: white;
  padding: 20px;
}

#navbar header {
  font-size: 22px;
  margin-bottom: 20px;
}

.nav-link {
  display: block;
  color: white;
  text-decoration: none;
  padding: 10px 0;
}

.nav-link:hover {
  color: #00d4ff;
}


/* Main document */

#main-doc {
  margin-left: 270px;
  padding: 30px;
}

.main-section {
  margin-bottom: 40px;
}

.main-section header {
  font-size: 28px;
  font-weight: bold;
}

code {
  display: block;
  background-color: #eee;
  padding: 15px;
  margin: 15px 0;
  border-radius: 5px;
}


/* Mobile layout */

@media (max-width: 768px) {

  #navbar {
    position: relative;
    width: 100%;
    height: auto;
  }

  #main-doc {
    margin-left: 0;
  }

}
