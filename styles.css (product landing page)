* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  text-align: center;
}


/* Header */

#header {
  position: fixed;
  top: 0;
  width: 100%;
  background-color: white;
  padding: 15px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

#header-img {
  width: 200px;
}


#nav-bar {
  display: flex;
  gap: 25px;
}


.nav-link {
  text-decoration: none;
  color: black;
}


/* Hero */

#hero {
  padding-top: 120px;
  padding-bottom: 50px;
}


#email {
  padding: 10px;
  width: 250px;
}


#submit {
  padding: 10px 20px;
  cursor: pointer;
}


/* Features */

#features {
  padding: 40px;
}


.feature-container {
  display: flex;
  justify-content: center;
  gap: 30px;
}


.feature {
  width: 250px;
  padding: 20px;
  background-color: #eeeeee;
}


/* Video */

#video-section {
  padding: 40px;
}


/* Pricing */

#pricing {
  padding: 40px;
}


.price {
  display: inline-block;
  margin: 20px;
  padding: 20px;
  border: 2px solid black;
}


/* Responsive design */

@media (max-width: 700px) {

  #header {
    flex-direction: column;
  }

  #nav-bar {
    flex-direction: column;
  }

  .feature-container {
    flex-direction: column;
    align-items: center;
  }

}
