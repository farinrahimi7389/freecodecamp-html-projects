body {
  margin: 0;
  padding: 40px;
  background-color: #0b3d2e;
  font-family: Arial, sans-serif;
}

#playing-cards {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 20px;
}

.card {
  width: 180px;
  height: 260px;
  background-color: white;
  border-radius: 15px;
  padding: 15px;
  display: flex;
  justify-content: space-between;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
  font-size: 30px;
}

.left {
  display: flex;
  align-self: flex-start;
}

.middle {
  display: flex;
  flex-direction: column;
  align-self: center;
  justify-content: center;
  align-items: center;
  font-size: 60px;
}

.right {
  display: flex;
  align-self: flex-end;
  transform: rotate(180deg);
}
