<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Smart Bottle</title>
  <link rel="stylesheet" href="styles.css">
</head>

<body>

<header id="header">

  <img 
    id="header-img" 
    src="https://cdn.freecodecamp.org/testable-projects-fcc/images/product-landing-page-logo.png" 
    alt="Smart Bottle Logo"
  >

  <nav id="nav-bar">
    <a class="nav-link" href="#features">Features</a>
    <a class="nav-link" href="#video-section">Video</a>
    <a class="nav-link" href="#pricing">Pricing</a>
  </nav>

</header>


<section id="hero">
  <h1>Smart Bottle</h1>
  <p>Stay hydrated with intelligent technology.</p>

  <form id="form" action="https://www.freecodecamp.org/email-submit">
    <input 
      id="email"
      type="email"
      name="email"
      placeholder="Enter your email address"
      required
    >

    <input 
      id="submit"
      type="submit"
      value="Get Started"
    >
  </form>
</section>


<section id="features">

  <h2>Features</h2>

  <div class="feature-container">

    <div class="feature">
      <h3>Smart Tracking</h3>
      <p>
        Track your daily water intake and receive reminders.
      </p>
    </div>

    <div class="feature">
      <h3>Premium Design</h3>
      <p>
        Built with durable materials and a modern style.
      </p>
    </div>

    <div class="feature">
      <h3>Long Battery</h3>
      <p>
        Enjoy weeks of use on a single charge.
      </p>
    </div>

  </div>

</section>


<section id="video-section">

  <h2>See It In Action</h2>

  <iframe
    id="video"
    width="560"
    height="315"
    src="https://www.youtube.com/embed/dQw4w9WgXcQ"
    title="Product video"
    frameborder="0"
    allowfullscreen>
  </iframe>

</section>


<section id="pricing">

  <h2>Pricing</h2>

  <div class="price">
    <h3>$49</h3>
    <p>Smart Bottle Basic</p>
  </div>

  <div class="price">
    <h3>$79</h3>
    <p>Smart Bottle Pro</p>
  </div>

</section>


</body>
</html>
